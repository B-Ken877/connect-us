# ============================================================================
# UNITED Research — environment variables
# Copy to ".env" (local) or configure in Vercel project settings (production).
# NEVER commit a real ".env".
# ============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
# Production: managed PostgreSQL (Vercel Postgres, Neon, Supabase, RDS…).
# Local dev: embedded PostgreSQL started by `bun scripts/dev-db.ts` (port 5433).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gig_survey?schema=public&sslmode=require"

# --- Authentication (REQUIRED) ----------------------------------------------
# Secret used to sign session JWTs (HS256). Generate with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-openssl-rand-base64-48"

# --- Dialer adapter (optional, default: native) ------------------------------
# "native"        → the agent's device/browser handles dialing via tel: links.
# "telephony-api" → reserved for a future real telephony provider integration.
DIALER_PROVIDER="native"

# --- Queue / concurrency tuning (optional) -----------------------------------
# Minutes before a stale respondent assignment lock is auto-released.
ASSIGNMENT_LOCK_MINUTES="120"

# --- Data-quality engine tuning (optional) -----------------------------------
QUALITY_MIN_DURATION_SECONDS="90"
QUALITY_MIN_SECONDS_PER_QUESTION="6"
QUALITY_REPETITION_THRESHOLD="4"
